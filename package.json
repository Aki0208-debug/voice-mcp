{
  "name": "voice-mcp",
  "version": "1.1.0",
  "description": "An MCP server for AI voice synthesis with inline audio player",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm audit --omit=dev"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "jose": "^6.2.8",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.120.0"
  },
  "keywords": [
    "mcp",
    "voice",
    "tts",
    "text-to-speech",
    "ai",
    "claude",
    "minimax"
  ],
  "license": "MIT"
}
